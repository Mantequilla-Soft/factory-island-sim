# Butter Factory configuration. Copy to .env.local and fill in what you need.

# Org/user pre-filled in the "Fetch GitHub Org" dialog.
VITE_DEFAULT_ORG=Mantequilla-Soft

# Optional read-only token for higher rate limits and private repos.
# LOCAL DEV ONLY: it is ignored in production builds, because any VITE_ value
# is baked into the public JavaScript bundle where anyone could read it.
VITE_GITHUB_TOKEN=

# Folder that holds <org>/index.json and <org>/<week>.json (written by scripts/collector.ts).
# The newest week loads on open, so a new weekly snapshot needs no redeploy.
# Defaults to this repo's `data` branch on raw.githubusercontent.com.
VITE_SNAPSHOTS_BASE=

# Extra hosts a ?snapshot= URL on /embed may point at (comma separated).
# raw.githubusercontent.com and cdn.jsdelivr.net are always allowed.
VITE_ALLOWED_SNAPSHOT_HOSTS=

# Who may frame /embed (server-side, CSP frame-ancestors source list).
# Defaults to 'self' https://snapie.io https://*.snapie.io. Not a VITE_ variable on purpose.
FRAME_ANCESTORS=

# Optional: pin one snapshot file instead of the newest week, e.g.
# https://raw.githubusercontent.com/<owner>/<repo>/data/snapshots/<org>/2026-W40.json
VITE_SNAPSHOT_URL=

# Used by scripts/collector.ts when run with Node (never sent to the browser).
GITHUB_TOKEN=
